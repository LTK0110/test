# SEC EDGAR は連絡先付き User-Agent を必須としています (会社名/用途 + メール)
IR_DATA_USER_AGENT=MyCompany IR Research takeru19880313@gmail.com

# 保存先 SQL DB の接続 URL (既定は SQLite)
# SQLite:     sqlite:///ir_data.db
# PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/irdata
# MySQL:      mysql+pymysql://user:pass@localhost:3306/irdata
# SQL Server: mssql+pyodbc://user:pass@host/irdata?driver=ODBC+Driver+18+for+SQL+Server
IR_DATA_DATABASE_URL=sqlite:///ir_data.db

# 取得時のチューニング
IR_DATA_RATE_LIMIT=8        # 秒間リクエスト上限 (SEC は最大 10)
IR_DATA_MAX_WORKERS=8       # 並列ワーカー数
IR_DATA_TIMEOUT=30          # リクエストタイムアウト(秒)
IR_DATA_MAX_RETRIES=3       # リトライ回数

# 任意: 商用 API の無料枠キー (補完用、未設定でも公式一次情報のみで動作)
# ALPHA_VANTAGE_API_KEY=
